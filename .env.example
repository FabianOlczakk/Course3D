# ── Database (PostgreSQL / Supabase) ────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# ── Auth ─────────────────────────────────────────────────────────────────────
# Required, min. 32 characters. Signs the custom HS256 session JWT.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Alias kept for backwards compatibility with Auth.js — same value as AUTH_SECRET.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Public app URL (used in invite/reset links and email templates) ─────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Resend (transactional email + campaigns) ────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Interaktywny Kurs Druku 3D <noreply@example.com>

# ── Deployment / admin developer panel (optional) ───────────────────────────
# Absolute path to a deploy script the admin "Developer" panel can trigger.
DEPLOY_SCRIPT=
# Absolute paths to PM2 stdout/stderr logs surfaced in the same panel.
PM2_OUT_LOG=
PM2_ERR_LOG=
# Directory for application log files (defaults to ./logs).
APP_LOG_DIR=
